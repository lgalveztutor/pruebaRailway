# Copiar este archivo a ".env.local" y completar con los datos de Supabase (Paso 2).
# Estas dos son PUBLICAS (pueden ir al frontend):
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# NUNCA poner la service_role key en el frontend.
# Si en el futuro hace falta para tareas de servidor, va aca (sin NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
