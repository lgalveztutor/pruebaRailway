<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="/site/support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
[id]{scroll-margin-top:86px;}
body{margin:0;background:#0E0F14;}
@keyframes lcgFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
@keyframes lcgFloat2{0%,100%{transform:translateY(0)}50%{transform:translateY(13px)}}
@keyframes lcgPulse{0%,100%{box-shadow:0 0 0 0 rgba(37,211,102,.5),0 16px 38px rgba(0,0,0,.5)}50%{box-shadow:0 0 0 18px rgba(37,211,102,0),0 16px 38px rgba(0,0,0,.5)}}
@keyframes lcgSpin{to{transform:rotate(360deg)}}
[data-reveal]{opacity:0;transform:translateY(34px);transition:opacity .85s cubic-bezier(.2,.7,.2,1),transform .85s cubic-bezier(.2,.7,.2,1);}
[data-reveal].in{opacity:1;transform:none;}
::placeholder{color:#6c7280;opacity:1;}
select option{background:#14151c;color:#F6F7FB;}
@media (prefers-reduced-motion: reduce){
  [data-reveal]{transition:none !important;}
}
input:focus,select:focus{outline:none;border-color:#19D3FF !important;box-shadow:0 0 0 3px rgba(25,211,255,.18);}
/* ===== Responsive para celular (agregado sin tocar el diseno original) ===== */
@media (max-width: 820px) {
  header nav { padding: 12px 16px !important; gap: 12px !important; }
  header nav > div { display: none !important; }
  [style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
  [style*="max-width:1280px"] { padding-left: 16px !important; padding-right: 16px !important; }
  [style*="padding:108px 40px"] { padding: 56px 18px !important; }
  img { max-width: 100% !important; height: auto !important; }
  h1, [style*="font-size:64px"], [style*="font-size:60px"], [style*="font-size:56px"],
  [style*="font-size:52px"], [style*="font-size:48px"] { font-size: 32px !important; line-height: 1.12 !important; }
  [style*="font-size:44px"], [style*="font-size:40px"], [style*="font-size:38px"] { font-size: 25px !important; line-height: 1.15 !important; }
  [style*="font-size:22px"], [style*="font-size:20px"] { font-size: 17px !important; }
}
</style>
</helmet>
<div style="position:relative;background:#0E0F14;color:#F6F7FB;font-family:Inter,sans-serif;overflow-x:hidden;min-height:100vh;">

<!-- ================= NAVBAR ================= -->
<header style="position:fixed;top:0;left:0;right:0;width:100%;z-index:80;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);background:rgba(14,15,20,.82);border-bottom:1px solid rgba(255,255,255,.07);">
  <nav style="max-width:1280px;margin:0 auto;padding:14px 40px;display:flex;align-items:center;gap:28px;">
    <a href="#inicio" style="display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;">
      <span style="display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:13px;background:linear-gradient(150deg,#1a1c24,#0c0d12);border:1px solid rgba(255,209,102,.35);box-shadow:0 0 22px rgba(255,200,80,.25);">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><defs><linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE27A"></stop><stop offset="1" stop-color="#FF9D00"></stop></linearGradient></defs><path d="M13.5 2 4 13.2h6.2L9 22l9.8-11.6H12L13.5 2Z" fill="url(#gold)"></path></svg>
      </span>
      <span style="line-height:1;">
        <span style="display:block;font-family:Montserrat;font-weight:900;font-size:16px;letter-spacing:.06em;color:#F6F7FB;">LA CHISPA GAMER</span>
        <span style="display:block;font-family:Montserrat;font-weight:700;font-size:10px;letter-spacing:.42em;color:#9CFF2E;margin-top:3px;">1.8</span>
      </span>
    </a>
    <div style="flex:1;display:flex;align-items:center;justify-content:center;gap:30px;">
      <a href="#experiencias" style="color:#9AA0AE;text-decoration:none;font-weight:600;font-size:15px;transition:color .2s;" style-hover="color:#F6F7FB;">Experiencias</a>
      <a href="#poolfutbol" style="color:#9AA0AE;text-decoration:none;font-weight:600;font-size:15px;transition:color .2s;" style-hover="color:#F6F7FB;">PoolFútbol</a>
      <a href="#cumpleanos" style="color:#9AA0AE;text-decoration:none;font-weight:600;font-size:15px;transition:color .2s;" style-hover="color:#F6F7FB;">Cumpleaños</a>
      <a href="#porhora" style="color:#9AA0AE;text-decoration:none;font-weight:600;font-size:15px;transition:color .2s;" style-hover="color:#F6F7FB;">Jugá por hora</a>
      <a href="#ubicacion" style="color:#9AA0AE;text-decoration:none;font-weight:600;font-size:15px;transition:color .2s;" style-hover="color:#F6F7FB;">Ubicación</a>
    </div>
  </nav>
</header>

<!-- ================= HERO ================= -->
<section id="inicio" data-screen-label="Hero" style="position: relative; display: flex; align-items: center; min-height: calc(100vh - 86px); padding: 92px 0 72px; flex-wrap: nowrap; background-color: #0E1018">
  <!-- Full-width cover background (approved scene) -->
  <img src="/site/chatgpt-image-29-jun-2026-18_49_12-mqzr3bgf.png" alt="" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0;">
  <!-- Soft left overlay for legibility + integrated dark zone hiding the old baked logo (top-left) -->
  <div style="position: absolute; inset: 0; z-index: 1; pointer-events: none; left: -7px; top: 1px"></div>

  <!-- Real HTML content (left) -->
  <div style="position:relative;z-index:2;width:100%;max-width:1280px;margin:0 auto;padding:0 40px;">
    <div data-reveal="" style="max-width:560px;">
      
      <img src="/site/uploads/la_chispa_gamer_1.8_logo_transparente.png" alt="La Chispa Gamer 1.8" style="display: block; width: clamp(250px,22vw,310px); max-width: 64vw; height: auto; filter: drop-shadow(0 16px 40px rgba(0,0,0,.55)); margin: 0 0 24px; animation: @keyframes float {   0%, 100% { transform: translateY(0px); }   50% { transform: translateY(-15px); } }  img[alt=&quot;La Chispa Gamer 1.8&quot;] {   animation: float 3s ease-in-out infinite; }"><h1 style="font-family:Montserrat;font-weight:900;font-size:62px;line-height:1.02;letter-spacing:-.01em;margin:20px 0 0;color:#F6F7FB;text-shadow:0 4px 30px rgba(0,0,0,.6);">El nuevo punto<br>gamer de <span style="color: #FFF601; text-shadow: 0 0 32px rgba(255,45,142,.6)">Berazategui</span></h1>
      <p style="font-size:19px;line-height:1.6;color:#D7DAE2;max-width:540px;margin:24px 0 0;text-shadow:0 2px 16px rgba(0,0,0,.7);">PS5, realidad virtual, baile y la única mesa de <span style="color:#9CFF2E;font-weight:600;">PoolFútbol</span> oficial del país. Vení con amigos, festejá tu cumple o jugá por hora.</p>
      <div style="display:flex;gap:15px;flex-wrap:wrap;margin-top:36px;">
        <a href="{{ waHero }}" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 10px; background: linear-gradient(135deg, #FF016D, #539AD9); color: #fff; font-weight: 700; font-size: 17px; text-decoration: none; padding: 16px 28px; border-radius: 16px; box-shadow: 0 14px 36px rgba(255,45,142,.45); transition: transform .18s,box-shadow .18s" style-hover="transform:translateY(-3px) scale(1.02);box-shadow:0 20px 46px rgba(255,45,142,.6);" style-focus="box-shadow:0 0 0 3px rgba(255,45,142,.5);">
          <svg viewBox="0 0 32 32" width="21" height="21" fill="currentColor" aria-hidden="true"><path d="M16.003 0C7.18 0 .004 7.176.004 16c0 2.82.737 5.585 2.137 8.02L0 32l8.18-2.14A15.94 15.94 0 0 0 16 32C24.82 32 32 24.824 32 16S24.82 0 16.003 0zm0 29.33c-2.5 0-4.95-.67-7.09-1.94l-.51-.3-4.85 1.27 1.29-4.73-.33-.53A13.27 13.27 0 0 1 2.67 16c0-7.35 5.98-13.33 13.34-13.33 3.56 0 6.9 1.39 9.42 3.91a13.23 13.23 0 0 1 3.9 9.42c0 7.36-5.98 13.33-13.33 13.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.9.2-.27.4-1.03 1.3-1.27 1.57-.23.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-1.99-2.37-2.23-2.77-.23-.4-.02-.61.18-.81.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.23-2.97-.32-.78-.65-.67-.9-.68l-.77-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.41 1.7.66 2.28.84.96.3 1.83.26 2.52.16.77-.11 2.37-.97 2.7-1.9.33-.94.33-1.74.23-1.9-.1-.17-.37-.27-.77-.47z"></path></svg>
          Reservá por WhatsApp
        </a>
        <a href="#experiencias" style="display: inline-flex; align-items: center; gap: 9px; background: rgba(255,255,255,.06); font-weight: 600; font-size: 17px; text-decoration: none; padding: 16px 26px; border-radius: 16px; border: 1px solid rgba(255,255,255,.26); backdrop-filter: blur(8px); transition: background .18s,border-color .18s; position: static; color: #FFFFFF; border-color: #FFFFFF42; border-style: none" style-hover="background:rgba(255,255,255,.13);border-color:rgba(255,255,255,.45);" style-focus="box-shadow:0 0 0 3px rgba(255,255,255,.3);">Ver experiencias</a>
      </div>
      <div style="display:flex;gap:28px;margin-top:38px;flex-wrap:wrap;">
        <div><div style="font-family:Montserrat;font-weight:800;font-size:22px;color:#F6F7FB;">5+</div><div style="font-size:13px;color:#C0C5D0;">experiencias</div></div>
        <div style="width:1px;background:rgba(255,255,255,.2);"></div>
        <div><div style="font-family:Montserrat;font-weight:800;font-size:22px;color:#F6F7FB;">6×3</div><div style="font-size:13px;color:#C0C5D0;">mesa PoolFútbol</div></div>
        <div style="width:1px;background:rgba(255,255,255,.2);"></div>
        <div><div style="font-family:Montserrat;font-weight:800;font-size:22px;color:#F6F7FB;">Por hora</div><div style="font-size:13px;color:#C0C5D0;">o cumpleaños</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ================= TRUST STRIP ================= -->
<section data-screen-label="Confianza" style="border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.018);">
  <div style="max-width:1280px;margin:0 auto;padding:22px 40px;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px 34px;">
    <span style="display:inline-flex;align-items:center;gap:9px;color:#C8CCD6;font-weight:600;font-size:15px;"><span style="width:6px;height:6px;border-radius:50%;background:#FF2D8E;"></span>Nuevo en Berazategui</span>
    <span style="color:rgba(255,255,255,.18);">•</span>
    <span style="display:inline-flex;align-items:center;gap:9px;color:#C8CCD6;font-weight:600;font-size:15px;"><span style="width:6px;height:6px;border-radius:50%;background:#9CFF2E;"></span>Alquiler por hora</span>
    <span style="color:rgba(255,255,255,.18);">•</span>
    <span style="display:inline-flex;align-items:center;gap:9px;color:#C8CCD6;font-weight:600;font-size:15px;"><span style="width:6px;height:6px;border-radius:50%;background:#FF2D8E;"></span>Cumpleaños</span>
  </div>
</section>

<!-- ================= EXPERIENCIAS ================= -->
<section id="experiencias" data-screen-label="Experiencias" style="position:relative;max-width:1280px;margin:0 auto;padding:112px 40px;overflow:hidden;">
  <div data-reveal="" style="position:relative;max-width:680px;">
    <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#FF2D8E;text-transform:uppercase;">Experiencias</div>
    <h2 style="font-family:Montserrat;font-weight:800;font-size:46px;line-height:1.05;margin:14px 0 0;color:#F6F7FB;">Todo lo que podés jugar acá</h2>
    <p style="font-size:18px;line-height:1.6;color:#9AA0AE;margin:16px 0 0;">Una sala pensada para venir con amigos y no parar. Elegí tu experiencia, reservá y caé.</p>
  </div>
  <div data-reveal="" style="position:relative;margin-top:48px;display:grid;grid-template-columns:1.18fr 1fr 1fr;grid-auto-rows:1fr;gap:22px;">
    <!-- VR feature (tall) -->
    <article style="grid-column:1;grid-row:1 / span 2;position:relative;border-radius:28px;overflow:hidden;border:1px solid rgba(255,255,255,.09);background:linear-gradient(180deg,rgba(25,211,255,.10),rgba(255,255,255,.03));min-height:440px;display:flex;flex-direction:column;justify-content:flex-end;transition:transform .25s,box-shadow .25s;" style-hover="transform:translateY(-6px);box-shadow:0 26px 56px rgba(25,211,255,.22);">
      <img src="/site/uploads/05-mascote-vr.png" alt="Realidad Virtual" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;opacity:.92;">
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(10,11,16,.55) 70%,rgba(10,11,16,.92));"></div>
      <div style="position:relative;padding:26px;">
        <div style="display:inline-flex;align-items:center;gap:7px;padding:6px 12px;border-radius:999px;background:rgba(25,211,255,.16);border:1px solid rgba(25,211,255,.4);color:#9DEBFF;font-weight:700;font-size:12px;letter-spacing:.04em;margin-bottom:12px;">DESTACADO</div>
        <h3 style="font-family:Montserrat;font-weight:800;font-size:28px;margin:0;color:#F6F7FB;">Realidad Virtual</h3>
        <p style="font-size:15px;line-height:1.5;color:#D7DAE2;margin:8px 0 0;max-width:300px;">Ponete los lentes y metete adentro del juego. Pura adrenalina.</p>
      </div>
    </article>
    <!-- PS5 -->
    <article style="position:relative;border-radius:26px;padding:26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s,border-color .25s;" style-hover="transform:translateY(-6px);box-shadow:0 22px 48px rgba(255,45,142,.18);border-color:rgba(255,45,142,.35);">
      <div style="display:flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:16px;background:rgba(255,45,142,.12);border:1px solid rgba(255,45,142,.28);color:#FF2D8E;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5.5"></rect><path d="M7 11v3M5.5 12.5h3"></path><circle cx="16.5" cy="11.5" r="1"></circle><circle cx="18.5" cy="14" r="1"></circle></svg>
      </div>
      <h3 style="font-family:Montserrat;font-weight:800;font-size:21px;margin:18px 0 0;color:#F6F7FB;">PlayStation 5</h3>
      <p style="font-size:14.5px;line-height:1.5;color:#9AA0AE;margin:7px 0 0;">FIFA, Fortnite y los últimos lanzamientos en pantalla grande.</p>
    </article>
    <!-- Pump It Up -->
    <article style="position:relative;border-radius:26px;padding:26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s,border-color .25s;" style-hover="transform:translateY(-6px);box-shadow:0 22px 48px rgba(255,45,142,.18);border-color:rgba(255,45,142,.35);">
      <div style="display:flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:16px;background:rgba(255,45,142,.12);border:1px solid rgba(255,45,142,.28);color:#FF2D8E;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2.2V15"></path><circle cx="6" cy="18" r="2.6"></circle><circle cx="16" cy="15.8" r="2.6"></circle></svg>
      </div>
      <h3 style="font-family:Montserrat;font-weight:800;font-size:21px;margin:18px 0 0;color:#F6F7FB;">Pump It Up</h3>
      <p style="font-size:14.5px;line-height:1.5;color:#9AA0AE;margin:7px 0 0;">Bailá, transpirá y batí el récord con tus amigos.</p>
    </article>
    <!-- Metegol -->
    <article style="position:relative;border-radius:26px;padding:26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s,border-color .25s;" style-hover="transform:translateY(-6px);box-shadow:0 22px 48px rgba(255,45,142,.18);border-color:rgba(255,45,142,.35);">
      <div style="display:flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:16px;background:rgba(255,45,142,.12);border:1px solid rgba(255,45,142,.28);color:#FF2D8E;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="10" rx="2.5"></rect><path d="M3 12h18M9 4.5V9M15 15v4.5"></path><circle cx="9" cy="12" r="1.1" fill="currentColor"></circle><circle cx="15" cy="12" r="1.1" fill="currentColor"></circle></svg>
      </div>
      <h3 style="font-family:Montserrat;font-weight:800;font-size:21px;margin:18px 0 0;color:#F6F7FB;">Metegol</h3>
      <p style="font-size:14.5px;line-height:1.5;color:#9AA0AE;margin:7px 0 0;">El clásico de siempre para picar entre partida y partida.</p>
    </article>
    <!-- PoolFútbol -->
    <article style="position:relative;border-radius:26px;padding:26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s,border-color .25s;" style-hover="transform:translateY(-6px);box-shadow:0 22px 48px rgba(255,45,142,.18);border-color:rgba(255,45,142,.35);">
      <div style="display:flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:16px;background:rgba(156,255,46,.12);border:1px solid rgba(156,255,46,.3);color:#9CFF2E;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.2l3 2.2-1.15 3.6h-3.7L9 9.4z"></path><path d="M12 7.2V4M14.85 13l2.7 1.7M9.15 13l-2.7 1.7"></path></svg>
      </div>
      <h3 style="font-family:Montserrat;font-weight:800;font-size:21px;margin:18px 0 0;color:#F6F7FB;">PoolFútbol</h3>
      <p style="font-size:14.5px;line-height:1.5;color:#9AA0AE;margin:7px 0 0;">La mesa gigante única del país. Solo la encontrás acá.</p>
    </article>
  </div>
</section>

<!-- ================= POOLFÚTBOL ================= -->
<section id="poolfutbol" data-screen-label="PoolFutbol" style="position:relative;padding:104px 0;border-top:1px solid rgba(255,255,255,.06);background:linear-gradient(160deg,rgba(25,211,255,.07),rgba(156,255,46,.04));overflow:hidden;">
  <div style="position:absolute;top:-10%;left:50%;width:760px;height:420px;transform:translateX(-50%);background:radial-gradient(ellipse,rgba(25,211,255,.18),transparent 70%);pointer-events:none;"></div>
  <div style="position:relative;max-width:1280px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1fr 1.06fr;gap:52px;align-items:center;">
    <div data-reveal="">
      <div style="display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:rgba(25,211,255,.12);border:1px solid rgba(25,211,255,.35);color:#9DEBFF;font-weight:700;font-size:12.5px;letter-spacing:.06em;">EL DIFERENCIAL · SOLO ACÁ</div>
      <h2 style="font-family:Montserrat;font-weight:900;font-size:48px;line-height:1.04;margin:18px 0 0;color:#F6F7FB;">PoolFútbol:<br><span style="color:#19D3FF;text-shadow:0 0 28px rgba(25,211,255,.4);">solo acá</span></h2>
      <p style="font-size:18px;line-height:1.65;color:#C0C5D0;margin:20px 0 0;max-width:480px;">La única mesa de PoolFútbol oficial del país: <span style="color:#9CFF2E;font-weight:600;">6×3 metros</span> de pura cancha. Pateás, embocás y la rompés con tus amigos. Una experiencia que no vas a encontrar en ningún otro lado.</p>
      <a href="{{ waPool }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;margin-top:30px;background:#19D3FF;color:#062b34;font-weight:700;font-size:16.5px;text-decoration:none;padding:15px 26px;border-radius:15px;box-shadow:0 14px 34px rgba(25,211,255,.35);transition:transform .18s,box-shadow .18s;" style-hover="transform:translateY(-3px);box-shadow:0 20px 44px rgba(25,211,255,.5);">
        <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16.003 0C7.18 0 .004 7.176.004 16c0 2.82.737 5.585 2.137 8.02L0 32l8.18-2.14A15.94 15.94 0 0 0 16 32C24.82 32 32 24.824 32 16S24.82 0 16.003 0zm0 29.33c-2.5 0-4.95-.67-7.09-1.94l-.51-.3-4.85 1.27 1.29-4.73-.33-.53A13.27 13.27 0 0 1 2.67 16c0-7.35 5.98-13.33 13.34-13.33 3.56 0 6.9 1.39 9.42 3.91a13.23 13.23 0 0 1 3.9 9.42c0 7.36-5.98 13.33-13.33 13.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.9.2-.27.4-1.03 1.3-1.27 1.57-.23.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-1.99-2.37-2.23-2.77-.23-.4-.02-.61.18-.81.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.23-2.97-.32-.78-.65-.67-.9-.68l-.77-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.41 1.7.66 2.28.84.96.3 1.83.26 2.52.16.77-.11 2.37-.97 2.7-1.9.33-.94.33-1.74.23-1.9-.1-.17-.37-.27-.77-.47z"></path></svg>
        Reservá tu partida
      </a>
    </div>
