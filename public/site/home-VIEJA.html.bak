<!-- ================= FLOATING WHATSAPP ================= -->
<a href="{{ waFloat }}" target="_blank" rel="noopener" aria-label="Reservá por WhatsApp" style="position:fixed;right:26px;bottom:26px;z-index:120;display:inline-flex;align-items:center;gap:11px;background:#25D366;color:#063018;font-weight:800;font-size:16px;text-decoration:none;padding:15px 22px 15px 18px;border-radius:999px;animation:lcgPulse 2.6s ease-in-out infinite;transition:transform .18s;" style-hover="transform:scale(1.05);">
  <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M16.003 0C7.18 0 .004 7.176.004 16c0 2.82.737 5.585 2.137 8.02L0 32l8.18-2.14A15.94 15.94 0 0 0 16 32C24.82 32 32 24.824 32 16S24.82 0 16.003 0zm0 29.33c-2.5 0-4.95-.67-7.09-1.94l-.51-.3-4.85 1.27 1.29-4.73-.33-.53A13.27 13.27 0 0 1 2.67 16c0-7.35 5.98-13.33 13.34-13.33 3.56 0 6.9 1.39 9.42 3.91a13.23 13.23 0 0 1 3.9 9.42c0 7.36-5.98 13.33-13.33 13.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.9.2-.27.4-1.03 1.3-1.27 1.57-.23.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-1.99-2.37-2.23-2.77-.23-.4-.02-.61.18-.81.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.23-2.97-.32-.78-.65-.67-.9-.68l-.77-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.41 1.7.66 2.28.84.96.3 1.83.26 2.52.16.77-.11 2.37-.97 2.7-1.9.33-.94.33-1.74.23-1.9-.1-.17-.37-.27-.77-.47z"></path></svg>
  Reservá
</a>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:1280,&quot;height&quot;:900}}">
class Component extends DCLogic {
  state = { nombre:'', dia:'', horario:'', experiencia:'PlayStation 5', personas:'', faqOpen:0 };

  /* >>> NUMERO DE WHATSAPP DEL LOCAL <<<  Formato: 549 + codigo de area (sin 0) + numero (sin 15).
     Ej: San Nicolas 336 15-1234567  ->  5493361234567 . Cambiar SOLO el numero de abajo: */
  get PHONE(){ return '5491100000000'; }
  wa(t){ return 'https://wa.me/' + this.PHONE + '?text=' + encodeURIComponent(t); }
  set(k){ return (e)=> this.setState({ [k]: e.target.value }); }

  reveal = () => {
    const vh = window.innerHeight || 800;
    document.querySelectorAll('[data-reveal]:not(.in)').forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh * 0.92 && r.bottom > 0) el.classList.add('in');
    });
  };
  componentDidMount(){
    this.reveal();
    this._onScroll = () => requestAnimationFrame(this.reveal);
    window.addEventListener('scroll', this._onScroll, { passive:true });
    window.addEventListener('resize', this._onScroll, { passive:true });
    // settle a few frames after mount for late layout
    requestAnimationFrame(this.reveal);
    setTimeout(this.reveal, 120);
  }
  componentWillUnmount(){
    window.removeEventListener('scroll', this._onScroll);
    window.removeEventListener('resize', this._onScroll);
  }

  renderVals(){
    const s = this.state;
    const base = '¡Hola La Chispa Gamer! 👋 Quiero reservar ' + (s.experiencia || '[PS5 / VR / PoolFútbol / cumpleaños]')
      + ' para el ' + (s.dia || '[día]') + ' a las ' + (s.horario || '[hora]')
      + ', para ' + (s.personas || '[cantidad]') + ' personas. ¿Tienen disponibilidad?'
      + (s.nombre ? (' Soy ' + s.nombre + '.') : '');

    const faqData = [
      { q:'¿Cómo reservo?', a:'Súper fácil: escribinos por WhatsApp con el botón de reserva o completá el formulario de la sección "Reservá". Te abrimos el chat con tu pedido ya escrito y coordinamos el turno al toque.' },
      { q:'¿Cuánto sale la hora de juego?', a:'El alquiler por hora arranca desde un precio accesible y varía según la experiencia y la cantidad de personas. Consultanos por WhatsApp y te pasamos los valores actualizados del día.' },
      { q:'¿Qué incluye un cumpleaños?', a:'Un espacio exclusivo para tu grupo con acceso a todas las experiencias: PS5, realidad virtual, baile, metegol y PoolFútbol. Armamos el combo según las edades y la cantidad de invitados.' },
      { q:'¿Desde qué edad puedo ir?', a:'Tenemos experiencias para todas las edades. Los más chicos pueden venir acompañados por un adulto. Si tenés dudas con una experiencia puntual (como la VR), consultanos y te orientamos.' },
      { q:'¿Qué es el PoolFútbol?', a:'Es la única mesa de PoolFútbol oficial del país: una cancha gigante de 6×3 metros donde pateás y embocás pelotas como en un pool, pero con los pies. Una experiencia que solo encontrás en La Chispa Gamer.' },
      { q:'¿Qué medios de pago aceptan?', a:'Aceptamos efectivo, transferencia y los principales medios digitales. Confirmanos por WhatsApp al momento de reservar y coordinamos la forma de pago que más te convenga.' },
      { q:'¿Cuáles son los horarios?', a:'Estamos abriendo el nuevo local en Berazategui Centro y vamos a confirmar los horarios definitivos muy pronto. Escribinos por WhatsApp y te decimos los turnos disponibles para el día que quieras venir.' }
    ];
    const faqs = faqData.map((f, i) => ({
      q: f.q, a: f.a,
      open: s.faqOpen === i,
      toggle: () => this.setState({ faqOpen: this.state.faqOpen === i ? -1 : i }),
      chev: s.faqOpen === i ? 'rotate(180deg)' : 'rotate(0deg)'
    }));

    return {
      reservaHref: this.wa(base),
      waHero: this.wa('¡Hola La Chispa Gamer! 👋 Quiero reservar un turno para jugar. ¿Tienen disponibilidad?'),
      waPool: this.wa('¡Hola La Chispa Gamer! 👋 Quiero reservar una partida de PoolFútbol. ¿Qué disponibilidad tienen?'),
      waCumple: this.wa('¡Hola La Chispa Gamer! 👋 Quiero info para festejar un cumpleaños. ¿Me pasan los detalles?'),
      waHora: this.wa('¡Hola La Chispa Gamer! 👋 Quiero reservar una hora de juego. ¿Qué turnos tienen libres?'),
      waFloat: this.wa('¡Hola La Chispa Gamer! 👋 Quiero reservar [PS5 / VR / PoolFútbol / cumpleaños] para el [día] a las [hora], para [cantidad] personas. ¿Tienen disponibilidad?'),
      waFinal: this.wa('¡Hola La Chispa Gamer! 👋 ¡Listos para jugar! Quiero reservar.'),
      mapaHref: 'https://www.google.com/maps?q=Av.+14+4143+Berazategui+Centro',
      nombre: s.nombre, dia: s.dia, horario: s.horario, experiencia: s.experiencia, personas: s.personas,
      setNombre: this.set('nombre'), setDia: this.set('dia'), setHorario: this.set('horario'),
      setExperiencia: this.set('experiencia'), setPersonas: this.set('personas'),
      faqs
    };
  }
}
</script>
</body>
</html>
