      <video src="/site/uploads/Seamless_looping_animation_of-d75eb2ec.mp4" poster="uploads/13-mascote-poolfutbol-mesa.png" autoplay="" loop="" muted="" playsinline="" style="width:100%;height:auto;display:block;"></video>
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,11,16,.04),rgba(10,11,16,.32));pointer-events:none;"></div>
      <div style="position:absolute;bottom:16px;left:16px;display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:10px;background:rgba(10,11,16,.7);backdrop-filter:blur(8px);border:1px solid rgba(25,211,255,.3);font-size:13px;font-weight:600;color:#C8CCD6;">
        <span style="width:8px;height:8px;border-radius:50%;background:#19D3FF;box-shadow:0 0 8px #19D3FF;"></span>Mesa PoolFútbol 6×3 · en vivo
      </div>
    </div>
  </div>
</section>

<!-- ================= CUMPLEAÑOS ================= -->
<section id="cumpleanos" data-screen-label="Cumpleanos" style="position:relative;padding:104px 0;overflow:hidden;">
  <div style="position:absolute;bottom:-20%;left:-8%;width:680px;height:680px;background:radial-gradient(circle,rgba(255,45,142,.20),transparent 66%);pointer-events:none;"></div>
  <div style="position:relative;max-width:1280px;margin:0 auto;padding:0 40px;display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:center;">
    <div data-reveal="" style="position:relative;display:flex;justify-content:center;">
      <div style="position:absolute;inset:8% 14%;background:radial-gradient(circle,rgba(255,45,142,.35),transparent 68%);filter:blur(6px);"></div>
      <img src="/site/uploads/14-mascote-solo.png" alt="Festejá tu cumpleaños en La Chispa Gamer" style="position:relative;width:84%;max-width:440px;height:auto;display:block;filter:drop-shadow(0 30px 50px rgba(0,0,0,.6));animation:lcgFloat 6s ease-in-out infinite;">
    </div>
    <div data-reveal="">
      <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#FF2D8E;text-transform:uppercase;">Cumpleaños &amp; Eventos</div>
      <h2 style="font-family:Montserrat;font-weight:900;font-size:46px;line-height:1.05;margin:14px 0 0;color:#F6F7FB;">El cumpleaños que<br>no se olvida más</h2>
      <p style="font-size:18px;line-height:1.65;color:#9AA0AE;margin:18px 0 0;max-width:470px;">Festejá con tus amigos entre PS5, realidad virtual, baile y PoolFútbol. Nosotros armamos todo: vos solo traés las ganas de jugar.</p>
      <div style="display:flex;flex-direction:column;gap:12px;margin:26px 0 0;">
        <div style="display:flex;align-items:center;gap:11px;font-size:16px;color:#D7DAE2;"><span style="display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:rgba(255,45,142,.16);color:#FF2D8E;flex-shrink:0;"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5 19 7"></path></svg></span>Espacio exclusivo para tu grupo</div>
        <div style="display:flex;align-items:center;gap:11px;font-size:16px;color:#D7DAE2;"><span style="display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:rgba(255,45,142,.16);color:#FF2D8E;flex-shrink:0;"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5 19 7"></path></svg></span>Todas las experiencias incluidas</div>
        <div style="display:flex;align-items:center;gap:11px;font-size:16px;color:#D7DAE2;"><span style="display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:rgba(255,45,142,.16);color:#FF2D8E;flex-shrink:0;"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17.5 19 7"></path></svg></span>Combos para distintas edades</div>
      </div>
      <a href="{{ waCumple }}" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;margin-top:30px;background:linear-gradient(135deg,#FF2D8E,#FF5BA6);color:#fff;font-weight:700;font-size:16.5px;text-decoration:none;padding:15px 26px;border-radius:15px;box-shadow:0 14px 34px rgba(255,45,142,.36);transition:transform .18s,box-shadow .18s;" style-hover="transform:translateY(-3px);box-shadow:0 20px 44px rgba(255,45,142,.52);">
        <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16.003 0C7.18 0 .004 7.176.004 16c0 2.82.737 5.585 2.137 8.02L0 32l8.18-2.14A15.94 15.94 0 0 0 16 32C24.82 32 32 24.824 32 16S24.82 0 16.003 0zm0 29.33c-2.5 0-4.95-.67-7.09-1.94l-.51-.3-4.85 1.27 1.29-4.73-.33-.53A13.27 13.27 0 0 1 2.67 16c0-7.35 5.98-13.33 13.34-13.33 3.56 0 6.9 1.39 9.42 3.91a13.23 13.23 0 0 1 3.9 9.42c0 7.36-5.98 13.33-13.33 13.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.9.2-.27.4-1.03 1.3-1.27 1.57-.23.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-1.99-2.37-2.23-2.77-.23-.4-.02-.61.18-.81.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.23-2.97-.32-.78-.65-.67-.9-.68l-.77-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.41 1.7.66 2.28.84.96.3 1.83.26 2.52.16.77-.11 2.37-.97 2.7-1.9.33-.94.33-1.74.23-1.9-.1-.17-.37-.27-.77-.47z"></path></svg>
        Pedí info de cumpleaños
      </a>
    </div>
  </div>
</section>

<!-- ================= JUGÁ POR HORA / PROMOS ================= -->
<section id="porhora" data-screen-label="PorHora" style="position:relative;padding:104px 0;border-top:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.018);">
  <div style="max-width:1280px;margin:0 auto;padding:0 40px;">
    <div data-reveal="" style="text-align:center;max-width:620px;margin:0 auto;">
      <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#9CFF2E;text-transform:uppercase;">Jugá por hora</div>
      <h2 style="font-family:Montserrat;font-weight:900;font-size:46px;line-height:1.05;margin:14px 0 0;color:#F6F7FB;">Vení cuando quieras,<br>jugá lo que quieras</h2>
      <p style="font-size:18px;line-height:1.6;color:#9AA0AE;margin:16px 0 0;">Sin vueltas: elegí tu turno, reservá por WhatsApp y caé a jugar. Ideal para una tarde con amigos.</p>
    </div>
    <div data-reveal="" style="margin-top:46px;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;">
      <!-- Promo 1 -->
      <article style="position:relative;border-radius:24px;padding:30px 26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s;" style-hover="transform:translateY(-6px);box-shadow:0 24px 50px rgba(0,0,0,.4);">
        <h3 style="font-family:Montserrat;font-weight:800;font-size:22px;margin:0;color:#F6F7FB;">Hora de juego</h3>
        <p style="font-size:14.5px;color:#9AA0AE;margin:8px 0 0;line-height:1.5;">Alquilá por hora la experiencia que más te guste.</p>
        <div style="margin:22px 0 0;font-family:Montserrat;font-weight:800;font-size:30px;color:#F6F7FB;">Desde <span style="color:#9CFF2E;">$—</span></div>
        <div style="font-size:13px;color:#9AA0AE;margin-top:2px;">por hora · consultá precio</div>
        <a href="{{ waHora }}" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:22px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#F6F7FB;font-weight:700;font-size:15px;text-decoration:none;padding:13px;border-radius:13px;transition:background .18s;" style-hover="background:rgba(255,255,255,.12);">Reservá tu hora</a>
      </article>
      <!-- Promo 2 (destacada) -->
      <article style="position:relative;border-radius:24px;padding:30px 26px;border:1px solid rgba(156,255,46,.4);background:linear-gradient(180deg,rgba(156,255,46,.10),rgba(255,255,255,.03));backdrop-filter:blur(16px);box-shadow:0 24px 56px rgba(156,255,46,.12);transition:transform .25s,box-shadow .25s;" style-hover="transform:translateY(-8px);box-shadow:0 30px 64px rgba(156,255,46,.22);">
        <div style="position:absolute;top:-13px;left:50%;transform:translateX(-50%);padding:6px 14px;border-radius:999px;background:#9CFF2E;color:#163800;font-weight:800;font-size:11.5px;letter-spacing:.06em;white-space:nowrap;">⚡ MÁS ELEGIDO</div>
        <h3 style="font-family:Montserrat;font-weight:800;font-size:22px;margin:6px 0 0;color:#F6F7FB;">Combo amigos</h3>
        <p style="font-size:14.5px;color:#C0C5D0;margin:8px 0 0;line-height:1.5;">Pack de horas para venir en grupo y rotar por todas las experiencias.</p>
        <div style="margin:22px 0 0;font-family:Montserrat;font-weight:800;font-size:30px;color:#F6F7FB;">Hasta <span style="color:#9CFF2E;">6</span></div>
        <div style="font-size:13px;color:#9AA0AE;margin-top:2px;">personas · consultá precio</div>
        <a href="{{ waHora }}" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:22px;background:#9CFF2E;color:#163800;font-weight:800;font-size:15px;text-decoration:none;padding:13px;border-radius:13px;transition:transform .18s;" style-hover="transform:scale(1.03);">Reservá el combo</a>
      </article>
      <!-- Promo 3 -->
      <article style="position:relative;border-radius:24px;padding:30px 26px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);backdrop-filter:blur(16px);transition:transform .25s,box-shadow .25s;" style-hover="transform:translateY(-6px);box-shadow:0 24px 50px rgba(0,0,0,.4);">
        <h3 style="font-family:Montserrat;font-weight:800;font-size:22px;margin:0;color:#F6F7FB;">Partida PoolFútbol</h3>
        <p style="font-size:14.5px;color:#9AA0AE;margin:8px 0 0;line-height:1.5;">Reservá la mesa única del país por turno y jugá tu torneo.</p>
        <div style="margin:22px 0 0;font-family:Montserrat;font-weight:800;font-size:30px;color:#F6F7FB;">Mesa <span style="color:#19D3FF;">6×3</span></div>
        <div style="font-size:13px;color:#9AA0AE;margin-top:2px;">por turno · consultá precio</div>
        <a href="{{ waPool }}" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:9px;margin-top:22px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);color:#F6F7FB;font-weight:700;font-size:15px;text-decoration:none;padding:13px;border-radius:13px;transition:background .18s;" style-hover="background:rgba(255,255,255,.12);">Reservá la mesa</a>
      </article>
    </div>
  </div>
</section>

<!-- ================= RESERVÁ ================= -->
<section id="reserva" data-screen-label="Reserva" style="position:relative;padding:104px 0;overflow:hidden;">
  <div style="position:absolute;top:0;right:0;width:560px;height:560px;background:radial-gradient(circle,rgba(25,211,255,.16),transparent 66%);pointer-events:none;"></div>
  <div style="position:relative;max-width:760px;margin:0 auto;padding:0 40px;">
    <div data-reveal="" style="text-align:center;">
      <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#19D3FF;text-transform:uppercase;">Reservá</div>
      <h2 style="font-family:Montserrat;font-weight:900;font-size:44px;line-height:1.05;margin:14px 0 0;color:#F6F7FB;">Armá tu reserva en 30 segundos</h2>
      <p style="font-size:17px;color:#9AA0AE;margin:14px 0 0;">Completá los datos y te abrimos el chat con todo escrito.</p>
    </div>
    <div data-reveal="" style="margin-top:38px;border-radius:28px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.04);backdrop-filter:blur(20px);padding:34px;box-shadow:0 30px 70px rgba(0,0,0,.45);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
        <label style="grid-column:1 / -1;display:block;">
          <span style="display:block;font-size:13px;font-weight:600;color:#C0C5D0;margin-bottom:8px;">Tu nombre</span>
          <input type="text" value="{{ nombre }}" onChange="{{ setNombre }}" placeholder="Ej: Lucas" style="width:100%;background:rgba(10,11,16,.55);border:1px solid rgba(255,255,255,.14);border-radius:13px;padding:14px 15px;color:#F6F7FB;font-size:15.5px;color-scheme:dark;">
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:13px;font-weight:600;color:#C0C5D0;margin-bottom:8px;">Día</span>
          <input type="date" value="{{ dia }}" onChange="{{ setDia }}" style="width:100%;background:rgba(10,11,16,.55);border:1px solid rgba(255,255,255,.14);border-radius:13px;padding:14px 15px;color:#F6F7FB;font-size:15.5px;color-scheme:dark;">
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:13px;font-weight:600;color:#C0C5D0;margin-bottom:8px;">Horario</span>
          <input type="time" value="{{ horario }}" onChange="{{ setHorario }}" style="width:100%;background:rgba(10,11,16,.55);border:1px solid rgba(255,255,255,.14);border-radius:13px;padding:14px 15px;color:#F6F7FB;font-size:15.5px;color-scheme:dark;">
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:13px;font-weight:600;color:#C0C5D0;margin-bottom:8px;">Experiencia</span>
          <select value="{{ experiencia }}" onChange="{{ setExperiencia }}" style="width:100%;background:rgba(10,11,16,.55);border:1px solid rgba(255,255,255,.14);border-radius:13px;padding:14px 15px;color:#F6F7FB;font-size:15.5px;color-scheme:dark;">
            <option>PlayStation 5</option>
            <option>Realidad Virtual</option>
            <option>PoolFútbol</option>
            <option>Cumpleaños</option>
            <option>Evento</option>
          </select>
        </label>
        <label style="display:block;">
          <span style="display:block;font-size:13px;font-weight:600;color:#C0C5D0;margin-bottom:8px;">Cantidad de personas</span>
          <input type="number" min="1" value="{{ personas }}" onChange="{{ setPersonas }}" placeholder="Ej: 4" style="width:100%;background:rgba(10,11,16,.55);border:1px solid rgba(255,255,255,.14);border-radius:13px;padding:14px 15px;color:#F6F7FB;font-size:15.5px;color-scheme:dark;">
        </label>
      </div>
      <a href="{{ reservaHref }}" target="_blank" rel="noopener" style="display:flex;align-items:center;justify-content:center;gap:11px;margin-top:24px;background:linear-gradient(135deg,#FF2D8E,#FF5BA6);color:#fff;font-weight:800;font-size:18px;text-decoration:none;padding:17px;border-radius:16px;box-shadow:0 16px 40px rgba(255,45,142,.4);transition:transform .18s,box-shadow .18s;" style-hover="transform:translateY(-3px);box-shadow:0 22px 50px rgba(255,45,142,.56);">
        <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M16.003 0C7.18 0 .004 7.176.004 16c0 2.82.737 5.585 2.137 8.02L0 32l8.18-2.14A15.94 15.94 0 0 0 16 32C24.82 32 32 24.824 32 16S24.82 0 16.003 0zm0 29.33c-2.5 0-4.95-.67-7.09-1.94l-.51-.3-4.85 1.27 1.29-4.73-.33-.53A13.27 13.27 0 0 1 2.67 16c0-7.35 5.98-13.33 13.34-13.33 3.56 0 6.9 1.39 9.42 3.91a13.23 13.23 0 0 1 3.9 9.42c0 7.36-5.98 13.33-13.33 13.33zm7.31-9.96c-.4-.2-2.37-1.17-2.74-1.3-.37-.13-.64-.2-.9.2-.27.4-1.03 1.3-1.27 1.57-.23.27-.47.3-.87.1-.4-.2-1.69-.62-3.22-1.99-1.19-1.06-1.99-2.37-2.23-2.77-.23-.4-.02-.61.18-.81.18-.18.4-.47.6-.7.2-.23.27-.4.4-.67.13-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.23-2.97-.32-.78-.65-.67-.9-.68l-.77-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.41 1.7.66 2.28.84.96.3 1.83.26 2.52.16.77-.11 2.37-.97 2.7-1.9.33-.94.33-1.74.23-1.9-.1-.17-.37-.27-.77-.47z"></path></svg>
        Reservar por WhatsApp
      </a>
      <p style="text-align:center;font-size:13.5px;color:#9AA0AE;margin:14px 0 0;">Te abrimos el chat con tu pedido ya escrito.</p>
    </div>
  </div>
</section>

<!-- ================= GALERÍA ================= -->
<section id="galeria" data-screen-label="Galeria" style="position:relative;padding:104px 0;border-top:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.018);">
  <div style="max-width:1280px;margin:0 auto;padding:0 40px;">
    <div data-reveal="" style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;">
      <div>
        <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#FF2D8E;text-transform:uppercase;">Galería</div>
        <h2 style="font-family:Montserrat;font-weight:900;font-size:42px;line-height:1.05;margin:12px 0 0;color:#F6F7FB;">Así se vive La Chispa</h2>
      </div>
      <span style="font-size:14px;color:#9AA0AE;">Fotos y videos reales del local</span>
    </div>
    <div data-reveal="" style="margin-top:36px;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:200px;gap:18px;">
      <div style="grid-column:span 2;grid-row:span 2;border-radius:22px;border:1px dashed rgba(255,255,255,.18);background:rgba(255,255,255,.03);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#8a909e;">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="3"></rect><circle cx="8.5" cy="10" r="1.7"></circle><path d="m4 18 5-5 4 3.5 3-2.5 4 4"></path></svg>
        <span style="font-size:14px;font-weight:600;">foto local · sala principal</span>
      </div>
      <div style="border-radius:22px;border:1px dashed rgba(255,255,255,.18);background:rgba(255,255,255,.03);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#8a909e;text-align:center;padding:14px;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 5.5v13l11-6.5z"></path></svg>
        <span style="font-size:13px;font-weight:600;">loop: PoolFútbol</span>
