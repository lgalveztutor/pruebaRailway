</section>

<!-- ================= FAQ ================= -->
<section id="faq" data-screen-label="FAQ" style="position:relative;padding:104px 0;border-top:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.018);">
  <div style="max-width:840px;margin:0 auto;padding:0 40px;">
    <div data-reveal="" style="text-align:center;">
      <div style="font-family:Montserrat;font-weight:700;font-size:13px;letter-spacing:.22em;color:#FF2D8E;text-transform:uppercase;">Preguntas frecuentes</div>
      <h2 style="font-family:Montserrat;font-weight:900;font-size:42px;line-height:1.05;margin:12px 0 0;color:#F6F7FB;">¿Te quedó alguna duda?</h2>
    </div>
    <div data-reveal="" style="margin-top:38px;display:flex;flex-direction:column;gap:14px;">
      <sc-for list="{{ faqs }}" as="item" hint-placeholder-count="7">
        <div style="border-radius:18px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.035);overflow:hidden;">
          <button onClick="{{ item.toggle }}" style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;text-align:left;background:transparent;border:0;cursor:pointer;padding:20px 22px;color:#F6F7FB;font-family:Inter,sans-serif;font-weight:700;font-size:17px;">
            <span>{{ item.q }}</span>
            <span style="flex-shrink:0;display:flex;transition:transform .25s;transform:{{ item.chev }};color:#FF2D8E;"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></span>
          </button>
          <sc-if value="{{ item.open }}" hint-placeholder-val="{{ true }}">
            <div style="padding:0 22px 22px;font-size:15.5px;line-height:1.6;color:#9AA0AE;">{{ item.a }}</div>
          </sc-if>
        </div>
      </sc-for>
    </div>
  </div>
</section>

